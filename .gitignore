# Built-in Git Ignore Template for Android

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Gradle
proguard/

# Log Files
*.log

# Android Studio releases
captures/

# IntelliJ files
.idea/
*.iml
*.iws

# Keystore files
*.jks
*.keystore

# Google Play Services values
google-services.json

# Full Stack Repository (Frontend & Backend Included)
node_modules/
backend/node_modules/
.env
backend/.env
__pycache__/
backend/__pycache__/
*.pyc
.DS_Store
*.swp
*.bak
dist/
build/
.next/
.idea/
.vscode/
