# Built-in Git Ignore Template for Android

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Gradle
proguard/

# Log Files
*.log

# Android Studio releases
captures/

# IntelliJ files
.idea/
*.iml
*.iws

# Keystore files
*.jks
*.keystore

# Google Play Services values
google-services.json

# Backend (Excluded as per "frontend" request)
# If you want to include the backend, remove the line below:
backend/
